{
    "id": "https://zevsafe.pages.dev/",
    "name": "ZevSafe — Offline File Encryption",
    "short_name": "ZevSafe",
    "description": "100% client-side AES-256-GCM folder encryption. Your files and passwords never leave your device.",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
    "orientation": "any",
    "background_color": "#08091a",
    "theme_color": "#08091a",
    "lang": "en-US",
    "dir": "ltr",
    "categories": ["security", "utilities", "productivity"],
    "icons": [
        {
            "src": "./assets/favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "./assets/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./assets/icon-192.webp",
            "sizes": "192x192",
            "type": "image/webp",
            "purpose": "any"
        },
        {
            "src": "./assets/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "./assets/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./assets/icon-512.webp",
            "sizes": "512x512",
            "type": "image/webp",
            "purpose": "any"
        },
        {
            "src": "./assets/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "file_handlers": [
        {
            "action": "./index.html",
            "name": "ZevSafe Encrypted Vault",
            "icons": [
                {
                    "src": "./assets/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ],
            "accept": {
                "application/x-zevsafe-vault": [".zev"]
            }
        }
    ],
    "screenshots": [
        {
            "src": "./assets/screenshot-wide.png",
            "sizes": "1280x800",
            "type": "image/png",
            "form_factor": "wide",
            "label": "ZevSafe Zero-Knowledge In-Browser Vault Encryption"
        },
        {
            "src": "./assets/screenshot-narrow.png",
            "sizes": "780x1688",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "ZevSafe Mobile Vault Encryption & In-Browser Playback"
        }
    ],
    "shortcuts": [
        {
            "name": "Encrypt Folder",
            "short_name": "Encrypt",
            "description": "Lock and encrypt a folder into a secure vault",
            "url": "./index.html#encrypt",
            "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Decrypt Vault",
            "short_name": "Decrypt",
            "description": "Unlock and restore a .zev vault file",
            "url": "./index.html#decrypt",
            "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
        }
    ],
    "launch_handler": {
        "client_mode": "navigate-existing"
    },
    "prefer_related_applications": false
}
